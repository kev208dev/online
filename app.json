{
  "expo": {
    "name": "online",
    "slug": "online",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.kev208dev.online",
      "supportsTablet": false,
      "appleTeamId": "822CM9WZ7Z",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "같은 Wi-Fi의 Mac 시연 서버와 줄서기·쿠폰 상태를 공유합니다.",
        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.online"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "입장 및 쿠폰 QR을 확인하기 위해 카메라 접근이 필요합니다."
        }
      ],
      ["expo-notifications", { "enableRemoteNotifications": false }],
      [
        "expo-navigation-bar",
        {
          "hidden": true
        }
      ],
      "expo-secure-store",
      "expo-maps"
    ],
    "scheme": "online"
  }
}
